# ── AI Provider Keys ─────────────────────────────────────────────
# 키를 비워두면 해당 기능은 자동으로 "데모 모드"(로컬 생성)로 동작합니다.

# OpenAI GPT — 캐릭터 기획/설정 텍스트 생성
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini — 캐릭터 아트 이미지 생성 (Nano Banana)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── App ──────────────────────────────────────────────────────────
# 결과물이 저장되는 디렉토리
OUTPUT_DIR=outputs

# CapCut draft 프로젝트가 생성될 위치 (선택)
# CapCut 앱의 "초안(draft)" 폴더 경로를 넣으면 앱에서 바로 열립니다.
CAPCUT_DRAFT_DIR=

# 서버
HOST=127.0.0.1
PORT=8000
