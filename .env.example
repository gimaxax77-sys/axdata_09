# ── AI Provider Keys ─────────────────────────────────────────────
# 키를 비워두면 해당 기능은 자동으로 "데모 모드"(로컬 생성)로 동작합니다.

# OpenAI GPT — 캐릭터 기획/설정 텍스트 생성
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini — 캐릭터 아트 이미지 생성 (Nano Banana)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── App ──────────────────────────────────────────────────────────
# 결과물이 저장되는 디렉토리 (절대경로도 가능. 예: D:\AXData\결과물)
# 생성물은 이 아래에 <엔티티>_<이름>_<날짜시각>/ 폴더로 자동 저장됩니다.
OUTPUT_DIR=outputs

# CapCut draft 프로젝트가 생성될 위치 (선택)
# CapCut 앱의 "초안(draft)" 폴더 경로를 넣으면 앱에서 바로 열립니다.
CAPCUT_DRAFT_DIR=

# 서버
HOST=127.0.0.1
PORT=8000

# ── 예상 비용 표시용 단가 (USD, 실제 청구액과 다를 수 있음) ─────────
# 사용하는 모델의 실제 단가에 맞게 조정하세요.
OPENAI_PRICE_IN=0.15       # 입력 100만 토큰당 $
OPENAI_PRICE_OUT=0.60      # 출력 100만 토큰당 $
GEMINI_PRICE_IMAGE=0.039   # 이미지 1장당 $
USD_KRW=1350               # 원화 환산 환율(표시용)
